# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────

# Human-readable name shown in Hub dashboard and /health responses
APP_NAME=MAKR My Tool

# Injected automatically by GitHub Actions (--build-arg VERSION=...)
# Set manually for local dev
APP_VERSION=1.0.0-local

# Flask port — each tool gets a unique port (5101, 5102, ...)
APP_PORT=5101

# MCP sidecar port — always APP_PORT + 1000
MCP_PORT=6101

# Flask environment: development | production
FLASK_ENV=development

# ─────────────────────────────────────────────
# Auth (Hub integration)
# ─────────────────────────────────────────────

# Shared JWT signing secret — must match HUB_SECRET in makr-hub
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
HUB_SECRET=replace_with_shared_hub_secret

# Hub base URL — used for login redirects when a token is missing
HUB_URL=https://hub.makrholdings.com

# ─────────────────────────────────────────────
# Database (Postgres)
# ─────────────────────────────────────────────

DATABASE_URL=postgresql://makr:password@localhost/makr_[toolname]

# ─────────────────────────────────────────────
# Storage (S3 / S3-compatible)
# ─────────────────────────────────────────────

S3_BUCKET=makr-tools-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
